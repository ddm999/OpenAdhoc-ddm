    {
        sound.playSingle("gtc_exit");
        SequenceUtil::startPage(context, TopRoot);
        return 2;
    }
}

module DesignWorkRoot_Page4 // car model test
{
    attribute carx = 4.5f;
    attribute cary = -1.5f;
    attribute carz = 0f;
    attribute carr = 0f;
    attribute moveCamera = false;
    attribute camx = 0f;
    attribute camy = 1f;
    attribute camz = 6.5f;
    attribute camfov = 25f;

    method updateModel()
    {
        PosText.text = " CAR:\n x = %{self.carx}\n y = %{self.cary}\n z = %{self.carz}\n r = %{self.carr}\n CAMERA:\n x = %{self.camx}\n y = %{self.camy}\n z = %{self.camz}\n f = %{self.camfov}\n moveCam = %{self.moveCamera}";
        SceneFace.execCommand("setModelTranslation %{self.carx} %{self.cary} %{self.carz} car0");
        SceneFace.execCommand("setModelRotation 0 %{self.carr} 0 car0");
        SceneFace.execCommand("setCameraLookAt %{self.carx} %{self.cary} %{self.carz}");
        SceneFace.execCommand("setCameraPosition %{self.camx} %{self.camy} %{self.camz}");
        SceneFace.execCommand("setCameraFovY %{self.camfov}");
    }

    method onInitialize(context)
    { try {
        var cp = gtengine::MCarParameter(gtengine::MSpecDB::getCarCode("gtr_concept_tmv_01"));
        SceneFace.resetCommandQueue();
        SceneFace.setDefaultCarParameter(cp, 0);
        SceneFace.execCommand("changeCar _default car0");
        SceneFace.execCommand("resetGlobalMotionFrame");
        SceneFace.execCommand("setCameraMotionEnable 0");
        updateModel();

        DesignWorkRoot_Page4.setFocus(DesignWorkRoot_Page4);
    } catch (e) { pdistd::AppendFile("/APP_DATA_RAW/error.txt", "%{e}\n"); }}
    method onKeyPress(context, event)
    { try {
        if (event.keysym == CELL_PAD_CTRL_CROSS) {
            SequenceUtil::startPage(context, DesignWorkRoot_Page5);
        } else if (event.keysym == CELL_PAD_CTRL_TRIANGLE) {
            SequenceUtil::startPage(context, DesignWorkRoot_Page3);
        }

        if (event.keysym == CELL_PAD_CTRL_R1) {
            moveCamera = !moveCamera;
        }

        if (moveCamera)
        {
            if (event.keysym == CELL_PAD_CTRL_L3_LEFT) {
                self.camx -= 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_L3_RIGHT) {
                self.camx += 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_L3_UP) {
                self.camy -= 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_L3_DOWN) {
                self.camy += 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_LEFT) {
                self.camfov -= 1f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_RIGHT) {
                self.camfov += 1f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_UP) {
                self.camz -= 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_DOWN) {
                self.camz += 0.1f;
            }
        } else {
            if (event.keysym == CELL_PAD_CTRL_L3_LEFT) {
                self.carx -= 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_L3_RIGHT) {
                self.carx += 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_L3_UP) {
                self.cary -= 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_L3_DOWN) {
                self.cary += 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_LEFT) {
                self.carr -= 5f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_RIGHT) {
                self.carr += 5f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_UP) {
                self.carz -= 0.1f;
            } else if (event.keysym == CELL_PAD_CTRL_R3_DOWN) {
                self.carz += 0.1f;
            }
        }

        updateModel();
    } catch (e) { pdistd::AppendFile("/APP_DATA_RAW/error.txt", "%{self.e}\n"); }}
    method onCancel(context)
    {
        sound.playSingle("gtc_exit");
        SequenceUtil::startPage(context, TopRoot);
        return 2;
    }
}

module DesignWorkRoot_Page5 // graph test
{
    method onInitialize(context)
    { try {
        DesignWorkRoot_Page5.setFocus(DesignWorkRoot_Page5);

        Graph::Power::label.text = pdiext::MUnit::GetUnitOfPower();
        Graph::Torque::label.text = pdiext::MUnit::GetUnitOfTorque();
        Graph::RPM::label.text = pdiext::MUnit::GetUnitOfRpm();

        var gf_list = [Graph::Graph::gf_power, Graph::Graph::gf_torque];
        foreach (var gf in gf_list)
        {
            gf.type = "line";
            gf.line_width = 4.0f;
            gf.action_enabled = true;
            gf.index = 0.0f;
            gf.velocity = 0.0f;
            gf.scale = [1, -1];
        }

        var carcode = gtengine::MSpecDB::getCarCode("gtr_concept_tmv_01");
        var cp = gtengine::MCarParameter(carcode);
        Graph.set(context, cp);
    } catch (e) { pdistd::AppendFile("/APP_DATA_RAW/error.txt", "%{e}\n"); }}
    method onKeyPress(context, event)
    {
        if (event.keysym == CELL_PAD_CTRL_CROSS) {
            SequenceUtil::startPage(context, DesignWorkRoot_Page6);
        } else if (event.keysym == CELL_PAD_CTRL_TRIANGLE) {
            SequenceUtil::startPage(context, DesignWorkRoot_Page4);
        }
    }
    method onCancel(context)
    {
        sound.playSingle("gtc_exit");
        SequenceUtil::startPage(context, TopRoot);
        return 2;
    }

    module Graph
    {
        method set(context, cp)
        {
            Graph::line_power.visible = true;
            Graph::line_torque.visible = true;

            var car_code = cp.getCarCode();
            var cp_real;
            if (cp.isInstanceOf(gtengine::MCarThin))
                cp_real = gtengine::MCarParameter(car_code);
            else
                cp_real = cp;

            cp_real.beginInfo();
            var [power_data, torque_data, maxPS, maxTorque, curveRPM, revLimitRPM,
                 powerMaxX, torqueMaxX] = cp_real.buildEngineData(true, 0.0f, 0.0f, 0.95f, 0.85f);

            Topbar::Weight.text = cp_real.getWeightString();
            cp_real.endInfo();
            Topbar::Drivetrain.text = SpecDatabaseUtil::getCarDrivetrainText(context, car_code);

            var trMaxPS = pdiext::MUnit::GetPowerForDisplay(maxPS);
            var trMaxTorque = pdiext::MUnit::GetTorqueForDisplayF(maxTorque);

            Power::unit1.text = "%d".format(trMaxPS);
            var fm = trMaxTorque >= 100.0f ? "%d" : "%.1f";
            Torque::unit1.text = fm.format(trMaxTorque);
            RPM::unit0.text = "%d".format(0);
            RPM::unit1.text = "%d".format(revLimitRPM);   

            var x = Graph::gf_power.w * powerMaxX;
            x += Graph::gf_power.x;
            x -= Graph::line_power.h * 0.5f;
            Graph::line_power.x = x;

            var x = Graph::gf_torque.w * torqueMaxX;
            x += Graph::gf_torque.x;
            x -= Graph::line_torque.h * 0.5f;
            x -= Graph::line_torque.w;
            Graph::line_torque.x = x;

            var gf_list = [Graph::gf_power, Graph::gf_torque];
            var i = 0;
            foreach (var gf in gf_list)
            {
                gf.points = i == 0 ? power_data : torque_data;
                gf.action_enabled = true;
                gf.index = 0.0f;
                gf.velocity = 90.0f;
                i++;
            }
        }
    }
}

