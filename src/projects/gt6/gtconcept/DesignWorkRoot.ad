module DesignWorkRoot_Page12 // trophy test
{
    static sEventId = 0;
    static gp;

    method onInitialize(context)
    { try {
        DesignWorkRoot_Page12.setFocus(DesignWorkRoot_Page12);
        gp = GameParameterUtil::createFromFile("game_parameter/gt6/event/r2200.xml");
        update(context);
    } catch (e) { pdistd::AppendFile("/APP_DATA_RAW/error.txt", "%{e}\n"); }}
    method onKeyPress(context, event)
    { try {
        if (event.keysym == CELL_PAD_CTRL_CROSS) {
            SequenceUtil::startPage(context, DesignWorkRoot_Page13);
        } else if (event.keysym == CELL_PAD_CTRL_TRIANGLE) {
            SequenceUtil::startPage(context, DesignWorkRoot_Page11);
        } else if (event.keysym == CELL_PAD_CTRL_L3_RIGHT) {
            sEventId = (sEventId + 1) % gp.events.size;
            update(context);
        } else if (event.keysym == CELL_PAD_CTRL_L3_LEFT) {
            sEventId = (sEventId - 1 + gp.events.size) % gp.events.size;
            update(context);
        }
    } catch (e) { pdistd::AppendFile("/APP_DATA_RAW/error.txt", "%{e}\n"); }}
    method update(context)
    { try {
        var event = gp.events[sEventId];

        var course_label = gtengine::MSpecDB::getCourseLabel(event.track.course_code);
        var id = event.event_id;

        var [eval_type, best_record] = GAME_STATUS.user_profile.record.event_record.getBestRecord(id);
        var result;
        if (best_record == -1)
            result = 0;
        else
            result = (best_record <= event.eval_condition.gold) ? 1 : ((best_record <= event.eval_condition.silver) ? 2 : ((best_record <= event.eval_condition.bronze) ? 3 : 4));

        var saved_result = gLicenseTrophies[course_label];
        TrophyText.text = " event_id=%{id} \n course=%{course_label} \n res=%{result} \n saved=%{saved_result} ";
    } catch (e) { pdistd::AppendFile("/APP_DATA_RAW/error.txt", "%{e}\n"); }}
    method onCancel(context)
    {
        sound.playSingle("gtc_exit");
        SequenceUtil::startPage(context, TopRoot);
        return 2;
    }
}

