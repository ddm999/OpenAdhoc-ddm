module IntroRoot
{
    method onInitialize(context)
    {
        IntroRoot.setFocus(IntroRoot);
    }

    method onFinalize(context)
    {

    }

    method onCancel(context)
    {
        sound.playSingle("gtc_cancel");
        SequenceUtil::startProject(context, "gtmode");
        return 2;
    }
}

